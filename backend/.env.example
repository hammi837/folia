# App
APP_NAME=FOLIA
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=folia
DB_USER=postgres
DB_PASSWORD=your_password_here

# Or set a full URL instead of DB_* above:
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/folia

# CORS
FRONTEND_URL=http://localhost:5173

# Revenue day boundaries (today / week / date filters)
STORE_TIMEZONE=Asia/Karachi

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Production only — public API origin (no trailing slash), used for upload URLs
# PUBLIC_BASE_URL=https://your-api.koyeb.app
