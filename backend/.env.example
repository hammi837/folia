# App
APP_NAME=FOLIA
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=folia
DB_USER=postgres
DB_PASSWORD=your_password_here

# Or set a full URL instead of DB_* above:
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/folia

# CORS
FRONTEND_URL=http://localhost:5173

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
